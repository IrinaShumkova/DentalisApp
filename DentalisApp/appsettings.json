{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=DentalisDb;Trusted_Connection=True;Encrypt=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "RequiredLength": 6,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RequiredUniqueChars": 3
  },
  "Signin": {
    "RequireConfirmedAccount": true
  },
  "User": {
    "RequireUniqueEmail": true
  }
}