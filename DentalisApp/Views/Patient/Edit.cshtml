 @using DentalisApp.Web.ViewModels.Patient
 @model PatientEditViewModel

@{
    ViewData["Title"] = "Edit Patient";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-pencil-square text-primary"></i> Edit Patient
        </h2>
        <p class="text-muted">Update the patient's personal and medical information.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
                <form asp-controller="Patient" asp-action="Edit" method="post">


                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <!-- Personal Information -->
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-person text-primary"></i>
                    Personal Information
                </h5>

                <div class="row g-3">

                    <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"> Active patient</label>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EGN" class="form-label"></label>
                        <input asp-for="EGN" class="form-control" />
                        <span asp-validation-for="EGN" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SecondName" class="form-label"></label>
                        <input asp-for="SecondName" class="form-control" />
                        <span asp-validation-for="SecondName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Contact Information -->
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-telephone text-primary"></i>
                    Contact Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Medical Information -->
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-heart-pulse text-primary"></i>
                    Medical Information
                </h5>

                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="Allergies" class="form-label"></label>
                        <textarea asp-for="Allergies"
                                  class="form-control"
                                  rows="2"></textarea>
                        <span asp-validation-for="Allergies" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="MedicalHistory" class="form-label"></label>
                        <textarea asp-for="MedicalHistory"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="MedicalHistory" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <!-- Buttons -->
                <div class="d-flex justify-content-between">

                    <a asp-action="MyPatients"
                       class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>

                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>


