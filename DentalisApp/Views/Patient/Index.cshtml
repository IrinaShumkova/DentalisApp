@using DentalisApp.Web.ViewModels.Patient
@model IEnumerable<PatientIndexViewModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Patients</h2>
            <p class="text-muted">Manage your registered patients</p>
        </div>

        <a asp-controller="Patient"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Patient
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Patient Name</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No patients registered yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var patient in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@patient.FullName</strong>
                                </td>

                                <td>@(patient.Phone ?? "N/A")</td>

                                <td>@(patient.Email ?? "N/A")</td>

                                <td>
                                    @if (patient.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Patients"
                                       asp-action="Details"
                                       asp-route-id="@patient.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
