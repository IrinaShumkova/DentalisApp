@using DentalisApp.Web.ViewModels.Patient;
@model IEnumerable<AllMyPatientsViewModel>

@{
    ViewData["Title"] = "My Patients";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary"></i> My Patients
            </h2>
            <p class="text-muted mb-0">Manage your registered patients.</p>
        </div>

        <a asp-controller="Patient"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add New Patient
        </a>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form asp-controller="Patient"
                  asp-action="MyPatients"
                  method="get">

                <div class="row g-2">
                    <div class="col-md-10">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text"
                                   name="searchTerm"
                                   @*value="@Model.SearchTerm"*@
                                   class="form-control"
                                   placeholder="Search by patient name or phone..." />
                        </div>
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-outline-primary">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Patients Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Patient List
                <span class="badge bg-primary ms-2">
                    @Model.Count()
                </span>
            </h5>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Patient</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @patient.FullName
                                        </div>
                                        <small class="text-muted">
                                            Patient ID: #@patient.Id
                                        </small>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.Phone))
                                        {
                                            @patient.Phone
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not provided</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.Email))
                                        {
                                            @patient.Email
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not provided</span>
                                        }
                                    </td>

                                    <td>
                                        @if (patient.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-controller="Patient"
                                           asp-action="Details"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-primary btn-lg me-2"
                                           title="View details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        <a asp-controller="Patient"
                                           asp-action="Edit"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-warning btn-lg"
                                           title="Edit patient">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-controller="Patient"
                                           asp-action="Delete"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people text-muted"
                       style="font-size: 3rem;"></i>

                    <h5 class="mt-3">No patients found</h5>
                    <p class="text-muted">
                        You haven't added any patients yet, or no patients match your search.
                    </p>

                    <a asp-controller="Patient"
                       asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Add Your First Patient
                    </a>
                </div>
            }
        </div>
    </div>
</div>
